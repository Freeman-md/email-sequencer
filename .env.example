# Airtable personal access token: data.records:read + data.records:write.
# Grant access only to Cold Outreach Pipeline.
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=apphI2f8iKVYaDRbg

# Google Cloud OAuth client, application type: Web application. Enable Gmail API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Private server file; use an absolute mounted-volume path in production.
GMAIL_TOKEN_FILE=.data/gmail-token.json

# Browser HTTP Basic login: username operator; choose a strong password (16+ chars).
# Production requires HTTPS. Never expose the app without operator authentication.
APP_PASSWORD=
